-/* SUM A VECTOR WITH KAHAN'S METHOD. */
-
-xsum_flt xsum_sum_kahan (const xsum_flt *restrict vec,
-                         xsum_length n)
-{ double s, t, c, y;
-  xsum_length j;
-  s = 0.0;
-  c = 0.0;
-# if OPT_KAHAN_SUM
-  { for (j = 1; j < n; j += 2)
-    { y = vec[j-1] - c;
-      t = s;
-      s += y;
-      c = (s - t) - y;
-      y = vec[j] - c;
-      t = s;
-      s += y;
-      c = (s - t) - y;
-    }
-    for (j = j-1; j < n; j++)
-    { y = vec[j] - c;
-      t = s;
-      s += y;
-      c = (s - t) - y;
-    }
-  }
-# else
-  { for (j = 0; j < n; j++)
-    { y = vec[j] - c;
-      t = s;
-      s += y;
-      c = (s - t) - y;
-    }
-  }
-# endif
-  return (xsum_flt) s;
-}
