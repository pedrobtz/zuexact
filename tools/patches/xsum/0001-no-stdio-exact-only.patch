zuexact patch 0001: remove stdio, debug output and inexact summation from xsum.

CRAN's compiled-code check rejects any stdio symbol in the shared object,
even behind a debug switch that never runs. printf and the display
routines become no-ops unless DEBUG is defined; the non-exact summation
and debugging routines, used only by upstream's timing and debugging
programs, are removed with their declarations.

--- a/xsum.c
+++ b/xsum.c
@@ -23,7 +23,17 @@
 */
 
 
-#include <stdio.h>
+/* zuexact patch 0001: no stdio. Debug output is compiled only with -DDEBUG
+   (which also needs upstream's debugging routines, removed below); otherwise
+   printf and the display routines are no-ops, so no stdio symbol reaches the
+   shared object (CRAN's compiled-code check). */
+#ifdef DEBUG
+# include <stdio.h>
+#else
+# define printf(...) ((void) 0)
+# define xsum_small_display(sacc) ((void) 0)
+# define xsum_large_display(lacc) ((void) 0)
+#endif
 #include <string.h>
 #include <math.h>
 #include "xsum.h"
@@ -106,9 +116,9 @@
 /* SET UP DEBUG FLAG.  It's a variable if debuging is enabled, and a
    constant if disabled (so that no code will be generated then). */
 
+#ifdef DEBUG
 int xsum_debug = 0;
-
-#ifndef DEBUG
+#else
 # define xsum_debug 0
 #endif
 
@@ -2214,313 +2224,8 @@
   xsum_large_transfer_to_small (lacc);
   return xsum_small_div_int (&lacc->sacc, div);
 }
