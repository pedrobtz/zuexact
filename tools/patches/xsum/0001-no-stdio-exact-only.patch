-
-/* RETURN NUMBER OF CHUNKS IN USE IN LARGE ACCUMULATOR. */
-
-int xsum_large_chunks_used (xsum_large_accumulator *restrict lacc)
-{
-  int i, c;
-  c = 0;
-  for (i = 0; i < XSUM_LCHUNKS; i++)
-  { if (lacc->count[i] >= 0)
-    { c += 1;
-    }
-  }
-  return c;
-}
